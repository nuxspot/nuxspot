<Window x:Class="GranRuedaDorada.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GranRuedaDorada.Controls"
        Title="Gran Rueda Dorada"
        Width="600" Height="1060" MinWidth="360" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#07050F"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        PreviewKeyDown="OnKeyDown">

    <Window.Resources>
        <!-- Illuminated cabinet push-button: coloured face, top highlight, dark base it presses into. -->
        <Style x:Key="CabButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Arial Black, Segoe UI Black" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border CornerRadius="16" Background="#05030A" Margin="0,7,0,0" />
                            <Border x:Name="Face" CornerRadius="16" Margin="0,0,0,7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#50FFFFFF" BorderThickness="1.5">
                                <Grid>
                                    <Border CornerRadius="14,14,40,40" Height="24" VerticalAlignment="Top" Margin="7,3,7,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#A0FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ContentPresenter.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="2" Opacity="0.6" />
                                        </ContentPresenter.Effect>
                                    </ContentPresenter>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Margin" Value="0,6,0,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MeterLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial Black, Segoe UI Black" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#F6C544" />
            <Setter Property="Margin" Value="12,6,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.3" GradientOrigin="0.5,0.3" RadiusX="0.8" RadiusY="0.7">
                <GradientStop Color="#2A1450" Offset="0" />
                <GradientStop Color="#07050F" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Viewbox Stretch="Uniform" Margin="8">
            <Grid x:Name="Cabinet" Width="720" Height="1280">

                <!-- Cabinet body with gold trim -->
                <Border CornerRadius="34" BorderThickness="10">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFF6C8" Offset="0" />
                            <GradientStop Color="#B47C10" Offset="0.3" />
                            <GradientStop Color="#FFE9A0" Offset="0.5" />
                            <GradientStop Color="#7A4C04" Offset="0.75" />
                            <GradientStop Color="#F6C544" Offset="1" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A2266" Offset="0" />
                            <GradientStop Color="#1A0F2E" Offset="0.35" />
                            <GradientStop Color="#120A22" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="50" ShadowDepth="16" Opacity="0.8" />
                    </Border.Effect>
                </Border>
                <!-- Side chrome strips -->
                <Border CornerRadius="28" Margin="10" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#18FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.07" />
                            <GradientStop Color="#00FFFFFF" Offset="0.93" />
                            <GradientStop Color="#18FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="CabinetFlash" CornerRadius="34" BorderThickness="8" BorderBrush="#FFFFF1B8"
                        Opacity="0" IsHitTestVisible="False" />

                <Canvas x:Name="Stage">

                    <!-- Marquee -->
                    <Border Canvas.Left="30" Canvas.Top="18" Width="660" Height="92" CornerRadius="20"
                            BorderThickness="4" BorderBrush="#F6C544">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#B0182E" Offset="0" />
                                <GradientStop Color="#6A0A1A" Offset="0.5" />
                                <GradientStop Color="#3E0410" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Margin="34,10" Stretch="Uniform">
                            <Canvas x:Name="TitleHost" Width="600" Height="80" />
                        </Viewbox>
                    </Border>
                    <Canvas x:Name="MarqueeLightsHost" Canvas.Left="30" Canvas.Top="18" />

                    <!-- Bonus wheel -->
                    <Canvas x:Name="WheelHost" Canvas.Left="60" Canvas.Top="122" Width="600" Height="600" Cursor="Hand"
                            MouseLeftButtonDown="OnWheelClicked" />

                    <!-- Reels -->
                    <Border Canvas.Left="34" Canvas.Top="728" Width="652" Height="367" CornerRadius="22" Padding="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFF6C8" Offset="0" />
                                <GradientStop Color="#F6C544" Offset="0.2" />
                                <GradientStop Color="#A8740F" Offset="0.5" />
                                <GradientStop Color="#F6C544" Offset="0.8" />
                                <GradientStop Color="#FFF6C8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.7" />
                        </Border.Effect>
                        <Border CornerRadius="12" Background="#120A22" BorderBrush="#3B2208" BorderThickness="3" Padding="6,0">
                            <Grid>
                                <Grid x:Name="ReelGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                                <Rectangle x:Name="Payline" Height="4" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.75">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00D61F3A" Offset="0" />
                                            <GradientStop Color="#E6D61F3A" Offset="0.04" />
                                            <GradientStop Color="#E6D61F3A" Offset="0.96" />
                                            <GradientStop Color="#00D61F3A" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="#FF2840" BlurRadius="10" ShadowDepth="0" />
                                    </Rectangle.Effect>
                                </Rectangle>
                                <Border x:Name="Reel3Glow" HorizontalAlignment="Right" Width="202"
                                        BorderBrush="#FFFFD34D" BorderThickness="5" CornerRadius="6" Opacity="0" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FFD34D" BlurRadius="25" ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                    <Border Canvas.Left="22" Canvas.Top="894" Width="20" Height="36" CornerRadius="0,6,6,0" Background="#D61F3A"
                            BorderBrush="#FFF1B8" BorderThickness="2">
                        <TextBlock Text="1" Foreground="White" FontFamily="Arial Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Canvas.Left="678" Canvas.Top="894" Width="20" Height="36" CornerRadius="6,0,0,6" Background="#D61F3A"
                            BorderBrush="#FFF1B8" BorderThickness="2">
                        <TextBlock Text="1" Foreground="White" FontFamily="Arial Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Win plaque over the reels -->
                    <Border x:Name="WinPlaque" Canvas.Left="150" Canvas.Top="856" Width="420" Height="112" CornerRadius="18"
                            BorderBrush="#F6C544" BorderThickness="3" Visibility="Collapsed" IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="WinPlaqueScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Color="#EB281046" Offset="0" />
                                <GradientStop Color="#E00C0618" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WinAmountText" Text="0" FontFamily="Impact, Arial Black" FontSize="60"
                                       HorizontalAlignment="Center" Foreground="#FFF1B8">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FFC83C" BlurRadius="24" ShadowDepth="0" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="WinNameText" Text="" FontFamily="Arial Black, Segoe UI Black" FontSize="17"
                                       HorizontalAlignment="Center" Foreground="White" Margin="0,-4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Bonus call-out -->
                    <Border x:Name="BonusBanner" Canvas.Left="130" Canvas.Top="380" Width="460" Height="86" CornerRadius="16"
                            BorderBrush="#F6C544" BorderThickness="5" Visibility="Collapsed" IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BonusBannerScale" ScaleX="1" ScaleY="1" />
                                <RotateTransform Angle="-4" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF4058" Offset="0" />
                                <GradientStop Color="#A30A22" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5064" BlurRadius="40" ShadowDepth="0" />
                        </Border.Effect>
                        <TextBlock Text="¡GIRA LA RUEDA!" FontFamily="Impact, Arial Black" FontSize="50" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- LED meters -->
                    <Grid Canvas.Left="34" Canvas.Top="1104" Width="652" Height="68">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.7*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="10" Background="#0B0507" BorderBrush="#A8740F" BorderThickness="2">
                            <Grid>
                                <TextBlock Style="{StaticResource MeterLabel}" Text="CRÉDITOS" />
                                <c:LedDisplay x:Name="CreditMeter" Digits="7" Margin="10,24,12,8" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="10" Background="#0B0507" BorderBrush="#A8740F" BorderThickness="2">
                            <Grid>
                                <TextBlock Style="{StaticResource MeterLabel}" Text="APUESTA" />
                                <c:LedDisplay x:Name="BetMeter" Digits="1" Margin="10,24,14,8" />
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" CornerRadius="10" Background="#0B0507" BorderBrush="#A8740F" BorderThickness="2">
                            <Grid>
                                <TextBlock Style="{StaticResource MeterLabel}" Text="GANANCIA" />
                                <c:LedDisplay x:Name="WinMeter" Digits="6" Margin="10,24,12,8" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Button deck -->
                    <Grid Canvas.Left="24" Canvas.Top="1186" Width="672" Height="82">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InfoButton" Grid.Column="0" Style="{StaticResource CabButton}" Height="70" Click="OnInfo" FontSize="15">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6A7AE8" Offset="0" />
                                    <GradientStop Color="#27308A" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            PAGOS
                        </Button>
                        <Button x:Name="BetButton" Grid.Column="2" Style="{StaticResource CabButton}" Height="70" Click="OnBetOne" Foreground="#3A1F00">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFD95A" Offset="0" />
                                    <GradientStop Color="#C0790A" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock TextAlignment="Center">APOSTAR 1<LineBreak /><Run FontSize="11">CRÉDITO</Run></TextBlock>
                        </Button>
                        <Button x:Name="MaxButton" Grid.Column="4" Style="{StaticResource CabButton}" Height="70" Click="OnMaxBet">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF6A7E" Offset="0" />
                                    <GradientStop Color="#A50D26" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock TextAlignment="Center">APUESTA<LineBreak /><Run FontSize="11">MÁXIMA</Run></TextBlock>
                        </Button>
                        <Button x:Name="SpinButton" Grid.Column="6" Style="{StaticResource CabButton}" Height="80" Click="OnSpin"
                                FontFamily="Impact, Arial Black" FontSize="34">
                            <Button.Background>
                                <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="0.8" RadiusY="0.9">
                                    <GradientStop Color="#8DFFA8" Offset="0" />
                                    <GradientStop Color="#18A843" Offset="0.55" />
                                    <GradientStop Color="#0B6A28" Offset="1" />
                                </RadialGradientBrush>
                            </Button.Background>
                            <TextBlock x:Name="SpinLabel" Text="GIRAR" />
                        </Button>
                    </Grid>

                    <Button x:Name="MuteButton" Canvas.Left="646" Canvas.Top="130" Width="48" Height="48" Click="OnMute"
                            Focusable="False" Cursor="Hand" ToolTip="Sonido">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="24" Background="#60000000" BorderBrush="#F6C544" BorderThickness="2">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="MuteLabel" Text="🔊" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="20" Foreground="#FFF1B8" />
                    </Button>
                </Canvas>

                <!-- Big win celebration -->
                <Grid x:Name="BigWinOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                    <Grid.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#B0200A40" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Grid.Background>
                    <StackPanel VerticalAlignment="Center" Margin="0,40,0,0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <ScaleTransform x:Name="BigWinScale" ScaleX="1" ScaleY="1" />
                        </StackPanel.RenderTransform>
                        <Viewbox Width="640" Height="120">
                            <Canvas x:Name="BigWinTitleHost" Width="640" Height="120" />
                        </Viewbox>
                        <TextBlock x:Name="BigWinAmount" Text="0" FontFamily="Impact, Arial Black" FontSize="120"
                                   HorizontalAlignment="Center" Foreground="#FFF1B8">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FFB020" BlurRadius="40" ShadowDepth="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="CRÉDITOS" FontFamily="Arial Black" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <c:CoinShower x:Name="Coins" />

                <!-- Paytable -->
                <Border x:Name="PayOverlay" Visibility="Collapsed" Background="#F2080412" CornerRadius="34" Padding="36,30">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="TABLA DE PAGOS" FontFamily="Impact, Arial Black" FontSize="46"
                                   Foreground="#F6C544" HorizontalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Top" TextAlignment="Center" TextWrapping="Wrap" Foreground="#E8DCFF"
                                   FontFamily="Segoe UI" FontSize="17" Margin="0,6,0,14">
                            Una línea de pago. Apuesta <Bold>3 créditos</Bold> para activar la rueda:<LineBreak />
                            el símbolo <Bold>GIRA</Bold> en el tercer carrete otorga un giro de la rueda.
                        </TextBlock>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource CabButton}" Width="300" Height="66" Click="OnCloseInfo" Margin="0,16,0,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#6A7AE8" Offset="0" />
                                    <GradientStop Color="#27308A" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            VOLVER AL JUEGO
                        </Button>
                        <TextBlock x:Name="PayNotes" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="#C9B8EF"
                                   FontFamily="Segoe UI" FontSize="15" Margin="0,14,0,0" />
                        <Grid x:Name="PayRows" />
                    </DockPanel>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
